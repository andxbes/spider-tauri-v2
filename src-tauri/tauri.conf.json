{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spider Tauri",
  "version": "1.0.0",
  "identifier": "com.andxbes.spider-tauri",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run build:css",
    "beforeBuildCommand": "npm run build:css"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Spider Tauri",
        "width": 1280,
        "height": 800,
        "backgroundColor": "#f4f4f5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
